{
  "name": "hushnest-multiplatform",
  "version": "0.1.0",
  "private": true,
  "description": "HushNest for Web, Android and Windows",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "ZHENYING MAI",
  "license": "MIT",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && vite --host 127.0.0.1",
    "build": "npm run prepare:assets && tsc -b && vite build && node scripts/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:web": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "windows:helper": "node scripts/build-windows-helper.mjs",
    "windows:dev": "npm run build && npm run windows:helper && electron .",
    "windows:build": "npm run build && npm run windows:helper && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.hushnest.desktop",
    "productName": "HushNest",
    "copyright": "Copyright © 2026 ZHENYING MAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/audio/**",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/bin/",
        "to": "audio-guard/",
        "filter": [
          "**/*",
          "!*.pdb"
        ]
      },
      {
        "from": "dist/audio/",
        "to": "audio/"
      }
    ],
    "win": {
      "icon": "public/icon.png",
      "signExecutable": false,
      "artifactName": "HushNest-${version}-Windows-${arch}.${ext}"
    }
  }
}
